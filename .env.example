# Backend settings (FastAPI)
NEWS_AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/news_agent
NEWS_AGENT_GEMINI_API_KEY=your-gemini-api-key
NEWS_AGENT_TELEGRAM_MODE=bot
NEWS_AGENT_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
NEWS_AGENT_TELEGRAM_API_ID=123456
NEWS_AGENT_TELEGRAM_API_HASH=your-api-hash
NEWS_AGENT_TELEGRAM_SESSION_NAME=telegram_user_session
NEWS_AGENT_TELEGRAM_LOGIN_PHONE=+10000000000
NEWS_AGENT_NEWS_FEED_URL=https://www.espn.com/espn/rss/soccer/news
NEWS_AGENT_SCHEDULER_INTERVAL_SECONDS=900
NEWS_AGENT_POST_QUEUE_MAX_SIZE=200
NEWS_AGENT_FEATURE_FLAGS__USE_LLM_FOR_SUMMARIES=true
NEWS_AGENT_FEATURE_FLAGS__SCHEDULER_ENABLED=true

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
